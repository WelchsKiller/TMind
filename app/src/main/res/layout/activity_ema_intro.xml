<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_senior"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev"
            android:src="@drawable/ic_back" />
        <TextView
            android:id="@+id/tvTitle"
            style="@style/SeniorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ema_intro_title" />
        <ImageButton
            android:id="@+id/btnTts"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/read_aloud"
            android:src="@drawable/ic_speaker" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvIntro"
        style="@style/SeniorBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_weight="1"
        android:background="@drawable/bg_info_box"
        android:lineSpacingExtra="6dp"
        android:padding="20dp"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnStart"
        style="@style/SeniorButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_primary"
        android:text="@string/ema_intro_start"
        android:textColor="@color/white" />
</LinearLayout>
