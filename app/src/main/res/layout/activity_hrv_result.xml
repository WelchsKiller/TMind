<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_senior"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvTitle"
                style="@style/SeniorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hrv_result_title" />
            <ImageButton
                android:id="@+id/btnTts"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/read_aloud"
                android:src="@drawable/ic_speaker" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDate"
            style="@style/SeniorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary" />

        <com.nest.tmind.ecg.EcgSurfaceView
            android:id="@+id/ecgView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_outline"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/tvBpmLabel"
                style="@style/SeniorBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bpm_label" />
            <TextView
                android:id="@+id/tvBpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/teal_primary"
                android:textSize="36sp"
                android:textStyle="bold" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/border_gray" />
            <TextView
                android:id="@+id/tvHrvLabel"
                style="@style/SeniorBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hrv_ms_label" />
            <TextView
                android:id="@+id/tvHrvMs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/teal_primary"
                android:textSize="36sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvExplain"
            style="@style/SeniorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_info_box"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="@string/hrv_result_explain"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnNext"
            style="@style/SeniorButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/confirm_result"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
