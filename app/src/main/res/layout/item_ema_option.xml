<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/optRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ema_option"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView android:id="@+id/optEmoji" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="center" android:text="😐" android:textSize="28sp" />
    <TextView android:id="@+id/optLabel" style="@style/SeniorBody" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textSize="18sp" />
</LinearLayout>
