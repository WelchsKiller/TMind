<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_senior"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="뒤로" />
        <TextView android:id="@+id/tvTitle" style="@style/SeniorTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/hrv_guide_title" />
        <ImageButton android:id="@+id/btnTts" android:layout_width="56dp" android:layout_height="56dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_speaker" android:contentDescription="@string/read_aloud" />
    </LinearLayout>

    <TextView android:id="@+id/tvGuide" style="@style/SeniorBody" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="24dp" android:lineSpacingMultiplier="1.55" android:text="@string/hrv_guide_text" android:textSize="22sp" />

    <Button android:id="@+id/btnSkip" style="@style/SeniorButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_btn_outline" android:text="@string/hrv_skip" android:textColor="@color/teal_dark" />
    <Button android:id="@+id/btnStart" style="@style/SeniorButton" android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_btn_primary" android:text="@string/hrv_start" android:textColor="@color/white" />
</LinearLayout>
