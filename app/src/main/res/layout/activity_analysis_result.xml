<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_senior"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvTitle"
                style="@style/SeniorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/analysis_title" />
            <ImageButton
                android:id="@+id/btnTts"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/read_aloud"
                android:src="@drawable/ic_speaker" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResult"
            style="@style/SeniorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_result_bubble"
            android:padding="24dp"
            android:text="@string/result_default"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvDisclaimer"
            style="@style/SeniorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/teal_light"
            android:padding="14dp"
            android:text="@string/disclaimer"
            android:textColor="@color/teal_dark"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvBpm"
            style="@style/SeniorBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="BPM 79"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrevSection"
            style="@style/SeniorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/previous_analysis_section"
            android:textColor="@color/teal_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/prevList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvPrevEmpty"
            style="@style/SeniorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/previous_analysis_empty"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnViewAllAnalysis"
            style="@style/SeniorButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_outline"
            android:text="@string/view_all_analysis"
            android:textColor="@color/teal_dark" />

        <TextView
            android:id="@+id/tvFeedbackQuestion"
            style="@style/SeniorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/feedback_question"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnYes"
            style="@style/SeniorButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/feedback_yes"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnNo"
            style="@style/SeniorButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/feedback_no"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnUnknown"
            style="@style/SeniorButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/feedback_unknown"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
