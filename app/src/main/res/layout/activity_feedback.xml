<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_senior"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageButton android:id="@+id/btnTts" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="end" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_speaker" />

    <TextView android:id="@+id/tvDone" style="@style/SeniorTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/mission_complete" android:textSize="28sp" />

    <Button android:id="@+id/btnHome" style="@style/SeniorButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="48dp" android:background="@drawable/bg_btn_primary" android:text="@string/go_home" android:textColor="@color/white" />
</LinearLayout>
