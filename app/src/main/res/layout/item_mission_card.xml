<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mission_card_normal"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="96dp"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMissionTitle"
                style="@style/SeniorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mission_hrv"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvMissionSub"
                style="@style/SeniorBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mission_hrv_sub"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/checkDone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_check_done"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_white" />
        </FrameLayout>

        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_gray"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
