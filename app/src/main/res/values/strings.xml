    <!-- EMA -->
    <string name="ema_title">마음 상태</string>
    <string name="ema_intro_title">설문 안내</string>
    <string name="ema_intro_tag">시작 전 안내</string>
    <string name="ema_intro_lead">이제부터 마음 상태에 대한 설문을 시작하겠습니다.</string>
    <string name="ema_intro_body_morning">오전에 진행하실 설문은\n총 %1$d문항으로 구성되어 있으며,\n\n각 문항에 대해 \'매우 많이 있었다\' ~\n\'전혀 없었다\'의 5개 응답 중 가장\n해당하는 응답을 골라주세요.</string>
    <string name="ema_intro_body_afternoon">오후에 진행하실 설문은\n총 %1$d문항으로 구성되어 있으며,\n\n각 문항에 대해 \'매우 많이 있었다\' ~\n\'전혀 없었다\'의 5개 응답 중 가장\n해당하는 응답을 골라주세요.</string>
    <string name="ema_intro_body_extra">추가로 진행하실 설문은\n총 %1$d문항으로 구성되어 있으며,\n\n각 문항에 대해 \'매우 많이 있었다\' ~\n\'전혀 없었다\'의 5개 응답 중 가장\n해당하는 응답을 골라주세요.</string>
    <string name="ema_intro_start">설문 시작</string>
