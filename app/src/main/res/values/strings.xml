    <!-- HRV -->
    <string name="hrv_title">심박변이도 측정</string>
    <string name="hrv_guide_title">측정 방법 안내</string>
    <string name="hrv_guide_text">1. ECG 패치를 가슴에 부착해 주세요.\n\n2. 블루투스를 켜 주세요.\n   · 휴대폰 설정 → 블루투스 → 켜기\n   · 패치 전원이 켜져 있는지 확인\n   · 휴대폰과 패치가 가까이 있게 해주세요\n\n3. 편하게 앉아 5분간 가만히 계세요.\n\n4. 측정 중에는 말씀하지 마세요.</string>
    <string name="hrv_skip">건너뛰기</string>
    <string name="hrv_start">측정 시작</string>
    <string name="hrv_instruction">편하게 앉아 말씀하지 마시고\n잠시 기다려 주세요</string>
